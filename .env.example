# Локальная разработка и Docker Compose
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=events.notifications

# HTTP-порты (локально)
PORT=3000
# Consumer: PORT=3002, Notifier: PORT=3001 — задаются в скриптах или compose

# Telegram Bot API — получить у @BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# При проблемах с IPv6 / блокировкой — локальный Bot API server:
# TELEGRAM_API_BASE_URL=http://localhost:8081

# Consumer → Notifier
NOTIFIER_URL=http://localhost:3001

# chatId: напишите боту /start, затем:
# curl https://api.telegram.org/bot<TOKEN>/getUpdates

# Troubleshooting: PRECONDITION_FAILED на очереди RabbitMQ
# docker compose exec rabbitmq rabbitmqctl delete_queue events.notifications
