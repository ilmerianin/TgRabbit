# Локальная разработка (RabbitMQ через docker compose up rabbitmq)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=events.notifications

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_token_here

# Consumer → Notifier (локально)
NOTIFIER_URL=http://localhost:3001

# Порты HTTP-сервисов (переопределяются в docker-compose)
# producer: 3000, notifier: 3001, consumer: 3002 (health, без публикации наружу)
